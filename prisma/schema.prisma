// Vayeko - Schéma Prisma complet
// Plateforme locale tout-en-un Togo

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SELLER
  PROFESSIONAL
  REAL_ESTATE_AGENT
  RECRUITER
  ADMIN
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REFUSED
  MODIFIED
  CANCELLED
  COMPLETED
}

enum PropertyType {
  MAISON
  APPARTEMENT
  TERRAIN
  BUREAU
  LOCAL
  AUTRE
}

enum PropertyStatus {
  A_LOUER
  A_VENDRE
  VENDU
  LOUE
}

enum ContractType {
  CDI
  CDD
  STAGE
  FREELANCE
  INTERIM
  ALTERNANCE
}

enum CampusType {
  LOGEMENT_ETUDIANT
  STAGE
  FORMATION
  EVENEMENT
  OPPORTUNITE
  ANNONCE
  SERVICE
}

enum ListingCategory {
  ELECTRONIQUE
  VEHICULES
  MAISON
  VETEMENTS
  SERVICES
  MATERIEL
  EMPLOI
  AUTRE
}

enum ListingStatus {
  ACTIVE
  VENDU
  EXPIRE
  SUSPENDU
}

enum FavoriteTarget {
  PRODUCT
  SHOP
  SERVICE
  PROPERTY
  JOB
  LISTING
  CAMPUS
}

enum ReviewTarget {
  PRODUCT
  SHOP
  SERVICE
  PROPERTY
  PROFESSIONAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  avatar       String?
  city         String   @default("Lomé")
  quartier     String?
  bio          String?
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles        UserRole[]

  shops        Shop[]
  professionalProfiles ProfessionalProfile[]
  properties   Property[]
  jobOffers    JobOffer[]
  campusPosts  CampusPost[]
  listings     Listing[]
  orders       Order[] @relation("CustomerOrders")
  reservations Reservation[] @relation("CustomerReservations")
  favorites    Favorite[]
  reviews      Review[]
  notifications Notification[]

  @@index([city])
  @@index([email])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
}

model Shop {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  cover       String?
  description String?
  category    String
  city        String
  quartier    String?
  phone       String?
  whatsapp    String?
  email       String?
  horaires    String?
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products    Product[]
  orders      Order[]

  @@index([city])
  @@index([category])
  @@index([ownerId])
  @@index([isActive])
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  category     String
  price        Int // FCFA
  oldPrice     Int?
  images       String // JSON array
  stock        Int      @default(0)
  isAvailable  Boolean  @default(true)
  variants     String? // JSON
  delivery     Boolean  @default(true)
  pickup       Boolean  @default(true)
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  shopId       String
  sellerId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([shopId])
  @@index([category])
  @@index([price])
  @@index([isAvailable])
  @@index([city])
  @@index([updatedAt])

  // For global search, we store city denormalized via shop
  city         String   @default("Lomé")
}

model ProfessionalProfile {
  id          String   @id @default(cuid())
  businessName String
  slug        String   @unique
  logo        String?
  cover       String?
  description String?
  category    String
  city        String
  quartier    String?
  phone       String?
  whatsapp    String?
  email       String?
  horaires    String?
  isOpen      Boolean  @default(true)
  isVerified  Boolean  @default(false)
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  services    Service[]

  @@index([city])
  @@index([category])
  @@index([userId])
}

model Service {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String?
  category        String
  price           Int // FCFA base
  priceType       String   @default("À partir de")
  images          String // JSON
  isAvailable     Boolean  @default(true)
  professionalId  String
  city            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  reservations    Reservation[]

  @@index([professionalId])
  @@index([category])
  @@index([city])
}

model Property {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?
  price       Int // FCFA
  priceType   String         @default("par mois")
  city        String
  quartier    String?
  type        PropertyType
  status      PropertyStatus @default(A_LOUER)
  pieces      Int            @default(0)
  superficie  Int // m²
  photos      String // JSON
  features    String? // JSON
  agentId     String?
  contactPhone String?
  contactWhatsapp String?
  isAvailable Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  agent       User?          @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([city])
  @@index([type])
  @@index([status])
  @@index([price])
  @@index([isAvailable])
}

model JobOffer {
  id              String       @id @default(cuid())
  title           String
  slug            String       @unique
  companyName     String
  companyLogo     String?
  description     String
  competences     String // JSON array
  city            String
  contractType    ContractType
  salary          String?
  publicationDate DateTime     @default(now())
  deadline        DateTime?
  isActive        Boolean      @default(true)
  recruiterId     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  recruiter       User?        @relation(fields: [recruiterId], references: [id], onDelete: SetNull)

  @@index([city])
  @@index([contractType])
  @@index([isActive])
}

model CampusPost {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String
  type        CampusType
  city        String
  price       Int?
  contactName String?
  contactPhone String?
  contactWhatsapp String?
  authorId    String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([city])
  @@index([type])
}

model Listing {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  description String?
  price       Int
  images      String // JSON
  city        String
  quartier    String?
  category    ListingCategory
  sellerId    String?
  sellerName  String?
  contactPhone String?
  contactWhatsapp String?
  status      ListingStatus   @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  seller      User?           @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([city])
  @@index([category])
  @@index([status])
  @@index([price])
}

model Order {
  id              String      @id @default(cuid())
  customerId      String
  shopId          String?
  totalPrice      Int
  status          OrderStatus @default(NEW)
  deliveryAddress String?
  city            String      @default("Lomé")
  paymentMethod   String?     @default("CASH")
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer        User        @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  shop            Shop?       @relation(fields: [shopId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  history         OrderStatusHistory[]

  @@index([customerId])
  @@index([shopId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int     @default(1)
  priceAtOrder Int // snapshot

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  changedBy String? // userId
  note      String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model Reservation {
  id              String            @id @default(cuid())
  customerId      String
  serviceId       String?
  professionalId  String?
  date            String // YYYY-MM-DD
  time            String // HH:mm
  status          ReservationStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customer        User              @relation("CustomerReservations", fields: [customerId], references: [id], onDelete: Cascade)
  service         Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([serviceId])
  @@index([status])
  @@index([date])
}

model Favorite {
  id         String         @id @default(cuid())
  userId     String
  targetType FavoriteTarget
  targetId   String
  createdAt  DateTime       @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType])
}

model Review {
  id          String       @id @default(cuid())
  userId      String
  targetType  ReviewTarget
  targetId    String
  rating      Int // 1-5
  comment     String?
  response    String? // professional response
  isReported  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([userId])
  @@index([rating])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // NEW_ORDER, ORDER_STATUS, RESERVATION, etc.
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorId   String?
  targetType String?
  targetId  String?
  details   String? // JSON
  createdAt DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}
