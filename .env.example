# =====================================================
# Vayeko V1 — Variables d'environnement
# Copier ce fichier vers `.env.local` et remplir les valeurs.
# `.env.local` est ignoré par Git : ne JAMAIS le committer.
# =====================================================

# --- Côté client + serveur (préfixe NEXT_PUBLIC_ = exposé au navigateur, valeurs publiques uniquement) ---
# URL du projet Supabase (ex. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Clé "anon" publique Supabase (sécurisée par les RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL publique du site (ex. http://localhost:3000 ou https://vayeko.tg)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Code pays par défaut pour les liens WhatsApp (Togo)
NEXT_PUBLIC_WHATSAPP_COUNTRY_CODE=228

# --- Côté SERVEUR uniquement — ne jamais exposer au navigateur ---
# Clé service_role Supabase (bypass RLS) : utilisée UNIQUEMENT dans le code serveur
# (route handlers / server actions) pour l'audit et certaines opérations administratives.
SUPABASE_SERVICE_ROLE_KEY=
